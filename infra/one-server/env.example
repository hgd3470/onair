# 온에어 한 서버 실행 설정. `teum_up.py init`이 TEUM_HOME/teum.env를 만들고, 아래 값을 필요한 만큼 더한다.
# 키 값은 저장소에 넣지 않는다. teum.env는 권한 600.

# ---- 접속 ----
TEUM_PASS=                 # 청취 웹앱 공용 비밀번호 (init이 만든다)
TEUM_COOKIE_KEY=           # 로그인 쿠키 서명 키 (init이 만든다)
TEUM_SERVICE_TOKEN=        # 자동 제작 루프가 스튜디오에 붙을 때 쓰는 토큰 (init이 만든다)
TEUM_WEB_PORT=8780         # 스튜디오 웹 (/admin, /app, /api/v1)
TEUM_API_PORT=8790         # API (안쪽에서만)

# ---- 단계별 모델: 한 줄이 한 단계. 줄을 비우면 저장소 기본값(Gemini, GPT, Claude)을 쓴다 ----
TEUM_GENERATOR=gemini      # ② 대본 작성.   gemini[:모델] | openai[:모델] | local
TEUM_REVIEWER=openai       # ② 자체 검토.   openai[:모델] | gemini[:모델] | local
TEUM_SCRIPT_AGENT_MODE=        # ② 생성기 실행 방식. 비우면 생성기 설정(batch). standard | batch
TEUM_GENERATE_TIMEOUT=21600   # 생성 시간 제한(초). 배치는 몇 시간 걸릴 수 있다
TEUM_COLLECT_TIMEOUT=10800    # 수집 시간 제한(초)
TEUM_REFINE=claude         # ③ 검수.        claude[:claude-haiku-5-5 | claude-sonnet-5-5] | local
TEUM_LLM_URL=http://127.0.0.1:8000/v1   # local(시험용)이 붙는 OpenAI 호환 모델 서버 (vLLM, Ollama). EXAONE 출력은 비상업 라이선스라 서비스 대본에 쓰지 않는다
TEUM_LLM_MODEL=            # 비우면 서버가 내놓는 첫 모델 (예: LGAI-EXAONE/EXAONE-4.5-33B-AWQ)
TEUM_LLM_MAX_TOKENS=4000   # local 답 길이 상한
TEUM_LLM_MAX_SOURCE_CHARS=6000   # local일 때 소재 길이 상한(글자). 넘는 소재는 뒤를 줄이고 원본을 factory/source_originals에 남긴다
# API 키를 두는 곳 (권한 600). 키가 없는 단계는 실행하지 않고 이유를 기록한다
#   gemini, openai: TEUM_HOME/script_agent.env 에 GEMINI_API_KEY=, OPENAI_API_KEY=
#   claude:         아래 파일
REFINE_ANTHROPIC_KEY_FILE=~/.config/secrets/ClaudePlatform.key
REFINE_TOTAL_BUDGET_USD=30          # 검수기 실행 한 번(자동 루프에서는 한 바퀴)의 상한. 하루 상한은 API 키 콘솔의 지출 한도로 건다
TEUM_REFINE_DAILY_WARN_USD=5        # 하루 검수 비용 합계가 이 값을 넘으면 status와 log.jsonl에 경고를 남긴다 (멈추지는 않는다)
TEUM_KANANA_URL=           # 안전 검사 모델 서버(vLLM) 주소. 비우면 안전 검사를 건너뛰고 판정 사유에 그렇게 적힌다. 그렇게 통과한 대본은 자동 게시하지 않는다

# ---- ④ 음성 합성: Typecast ----
# 키는 TEUM_HOME/typecast.env 에 TYPECAST_API_KEY= 한 줄로 둔다 (권한 600)
TEUM_AUTO_VOICE=0          # 1이면 검수 통과 대본에 목소리를 배정해 바로 합성한다(비용이 든다). 0이면 사람이 사이트에서 음성을 만든다
TEUM_DAILY_CREDITS=5000    # 하루 합성 상한 (글자 수 = Typecast 크레딧)
TEUM_STT_PYTHON=           # 합성 음원을 받아써서 대본과 맞춰 보는 검사용 파이썬 (torch 필요, requirements-gpu.txt). 비우면 같은 파이썬

# ---- 자동 제작 루프 (ai/factory) ----
TEUM_FACTORY=0             # 1이면 소재 → 생성 → 검수 → 수정 왕복을 자동으로 돈다
TEUM_FACTORY_INTERVAL=600  # 초
TEUM_FACTORY_MAX_GENERATE=5    # 한 바퀴에 새로 생성할 대본 수 (비용 상한)
TEUM_FACTORY_MAX_REFINE=20     # 한 바퀴에 검수할 대본 수 (비용 상한)
TEUM_FACTORY_MAX_ROUNDS=2      # 검수 → 수정 왕복 상한. 넘으면 사람 확인으로 넘긴다
TEUM_FACTORY_REFINE_SCOPE=all  # all: 검수 대기 전부 / own: 자동 생성한 대본만
TEUM_AUTO_PUBLISH=0            # 0: 사람이 듣고 게시 / 1: 자동 생성한 대본은 받아쓰기 대조를 통과하면 게시 / all: 음성 완료 전부
TEUM_FACTORY_MAX_PUBLISH=20    # 한 바퀴에 게시할 편수
TEUM_AUTO_PUBLISH_HOLD_TOPICS=C16,C08   # 자동 게시하지 않고 사람 승인으로 남기는 분류 코드 (C16 뉴스·사회·시사, C08 돈·소비·생활경제). 비우면 제외 없음
TEUM_COLLECT_CMD=          # ① 소재 수집기 명령. 결과 md를 입력함(TEUM_HOME/script_agent/input)에 쓴다. 명령 안의 {inbox}가 그 경로로 바뀌고 $TEUM_INBOX로도 간다
                           #    예: python -m teum_factory.run_collector --categories C13 --count 3   (ai/source_collector를 부르고 통과한 소재를 입력함으로 옮긴다. 준비는 README의 "소재 수집기 연결")
TEUM_COLLECT_INTERVAL=86400    # 수집 명령을 부르는 간격(초). 기본 하루 한 번

# 로그인 없이 /api/v1을 쓸 수 있는 접속 대역(차량 앱, 에뮬레이터). 기본은 이 서버 자신(SSH 터널 포함).
# 공개 주소(Cloudflare)로 들어온 요청은 이 값과 상관없이 사이트 로그인이 필요하다. 예: Tailscale 대역을 더할 때 127.0.0.1/32,::1/128,100.64.0.0/10
# TEUM_API_OPEN_NETS=127.0.0.1/32,::1/128
