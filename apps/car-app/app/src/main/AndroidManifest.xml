<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 브리핑(날씨) 위치. 소수 둘째 자리(약 1km)로 줄여 요청 본문으로만 보내고 저장하지 않는다. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- Pleos: 목적지 남은 시간·거리(NaviHelper), 좌석 탑승(Vehicle Seat). -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- 기기 TTS(Pleos 음성 서비스)로 브리핑 문장을 읽는다. -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- 브리핑 낭독: 기기 TTS 엔진(Pleos 차량은 Pleos 음성 서비스)을 찾으려면 Android 11+ 에서 선언이 필요하다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- 차량(AAOS)이 기본 대상. 시연 준비용으로 폰 에뮬레이터 설치도 허용한다. -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <application
        android:name=".TeumApp"
        android:allowBackup="false"
        android:appCategory="audio"
        android:icon="@drawable/ic_teum"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Teum">

        <uses-library android:name="android.car" android:required="false" />

        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode">
            <!-- 주행 중에도 쓰는 화면(DO). 편집 화면은 CarUxRestrictions 로 정차 중에만 연다. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
